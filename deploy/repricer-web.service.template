[Unit]
Description=Repricer Web Dashboard ({{INSTANCE_NAME}})
After=network.target

[Service]
User={{USER}}
WorkingDirectory={{WORKING_DIR}}
ExecStart={{WORKING_DIR}}/.venv/bin/streamlit run app.py --server.port {{PORT}} --server.address 0.0.0.0
Restart=always
EnvironmentFile={{WORKING_DIR}}/.env

[Install]
WantedBy=multi-user.target