[Unit]
Description=Repricer Web Dashboard
After=network.target

[Service]
User=root
WorkingDirectory=/home/user/repricer-ozon
ExecStart=/home/user/repricer-ozon/venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0
Restart=always
EnvironmentFile=/home/user/repricer-ozon/.env

[Install]
WantedBy=multi-user.target