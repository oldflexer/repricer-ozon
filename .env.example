# Ozon Seller API (обязательно)
OZON_CLIENT_ID=your_client_id_here
OZON_API_KEY=your_api_key_here

# Email уведомления (опционально, если не настроены – письма не отправляются)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@yandex.ru
RECIPIENT_EMAIL=your_email@yandex.ru

# Путь к файлу с товарами (по умолчанию ./data/products.xlsx)
DATA_FILE=./data/products.xlsx

# Данные для входа в веб-интерфейс (пока не используются, но могут понадобиться)
WEB_USER=admin
WEB_PASS=password

# Коэффициент для товаров без индексов (по умолчанию 0.5)
COEFFICIENT_OZON=0.5

# Коэффициент для расчёта old_price (по умолчанию 1.5)
OLD_PRICE_MULTIPLIER=1.5

# Шаг округления old_price вверх (по умолчанию 100)
PRICE_ROUND_UP_TO=100

# Отправлять ли manage_elastic_boosting_through_price = false (по умолчанию false)
MANAGE_ELASTIC_BOOSTING=false

# Максимальное количество товаров для детализации в письме (при превышении – CSV)
NOTIFICATION_MAX_DETAILS=20