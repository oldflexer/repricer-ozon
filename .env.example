# ============================================
# Настройки экземпляра (для мультитенантности)
# ============================================

# Имя инстанса
INSTANCE_NAME=shop
# Порт дашборда (нужен разный для инстансов)
PORT=8501
# Расписание cron в формате crontab (по умолчанию каждый час)
CRON_SCHEDULE="0 * * * *"
# Расписание для парсера цен конкурентов (по умолчанию 3 раза в день: 02:30, 10:30, 18:30)
PARSER_CRON_SCHEDULE="30 2,10,18 * * *"

# ============================================
# Ozon Seller API (обязательно)
# ============================================

OZON_CLIENT_ID=your_client_id_here
OZON_API_KEY=your_api_key_here

# ============================================
# Email уведомления (опционально)
# ============================================

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@yandex.ru
RECIPIENT_EMAIL=your_email@yandex.ru
# Максимальное количество товаров для детализации в письме (при превышении – CSV)
NOTIFICATION_MAX_DETAILS=20

# ============================================
# Файлы данных (можно переопределить для каждого магазина)
# ============================================

DATA_FILE=./data/products.xlsx
DATABASE_PATH=./data/repricer.db

# ============================================
# Аутентификация веб-интерфейса
# ============================================

WEB_USER=admin
WEB_PASS=password

# ============================================
# Настройки Excel
# ============================================

# Количество интервалов стратегии в файле (Интервал 1..N)
SCHEDULE_INTERVALS_COUNT=4
# Названия колонок конкурентов
COMPETITOR_URL_COLUMN_PREFIX=Конкурент
COMPETITOR_PRICE_COLUMN_PREFIX=Цена

# ============================================
# Коэффициенты расчёта цен
# ============================================

# Коэффициент для товаров без индексов (по умолчанию 0.5)
COEFFICIENT_OZON=0.5
# Коэффициент для расчёта old_price (по умолчанию 1.5)
OLD_PRICE_MULTIPLIER=1.5
# Шаг округления old_price вверх (по умолчанию 100)
PRICE_ROUND_UP_TO=100
# Отправлять ли manage_elastic_boosting_through_price = false (по умолчанию false)
MANAGE_ELASTIC_BOOSTING=false

# ============================================
# Настройки парсера конкурентов
# ============================================

# Максимальное количество конкурентов (столбцы Конкурент 1..N)
MAX_COMPETITORS=5
# Количество попыток парсинга одной страницы
PARSER_RETRIES=2
# Задержка между запросами (мин и макс, сек)
PARSER_REQUEST_DELAY_MIN=5
PARSER_REQUEST_DELAY_MAX=10
# Таймаут ожидания освобождения Excel (сек)
EXCEL_LOCK_WAIT_TIMEOUT=60
# Таймаут блокировки парсера (filelock) (сек)
PARSER_LOCK_TIMEOUT=1800
# Версия Chrome для драйвера (если не определяется автоматически)
CHROME_VERSION_MAIN=150

# ============================================
# Настройки Ozon API
# ============================================

# Размер батча для API-запросов
API_BATCH_SIZE=100
# Количество повторных попыток
API_MAX_RETRIES=3
# Задержка между батчами (сек)
API_BATCH_DELAY=0.2
# Таймаут HTTP-запроса (сек)
API_HTTP_TIMEOUT=30

# ============================================
# Настройки репрайсинга
# ============================================

# Пауза после отправки цен перед получением актуальных (сек)
WAIT_AFTER_UPDATE_SECONDS=10

# ============================================
# Автоматическая очистка БД
# ============================================

# Срок хранения данных (месяцев)
CLEANUP_MONTHS=3
# Минимальный интервал между очистками (дней)
CLEANUP_DAYS_THRESHOLD=1