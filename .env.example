# ============================================
# Основные настройки экземпляра (multi-tenancy)
# ============================================

# Имя экземпляра (используется в именах файлов, логах, заголовке дашборда)
INSTANCE_NAME=shop
# Порт для веб-интерфейса (Streamlit)
PORT=8501
# Расписание cron для репрайсинга (стандартный cron формат)
CRON_SCHEDULE="0 * * * *"
# Расписание cron для парсера конкурентов
PARSER_CRON_SCHEDULE="30 2,10,18 * * *"

# ============================================
# Ozon Seller API (обязательные)
# ============================================

OZON_CLIENT_ID=your_client_id_here
OZON_API_KEY=your_api_key_here

# ============================================
# Email уведомления (опционально)
# ============================================

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@yandex.ru
RECIPIENT_EMAIL=your_email@yandex.ru
# Макс. товаров в детализации email; остальные уходят в CSV-вложение
NOTIFICATION_MAX_DETAILS=20

# ============================================
# Пути к файлам данных (поддерживают шаблон {{INSTANCE_NAME}})
# ============================================

# Excel-файл с товарами (поддерживает {{INSTANCE_NAME}})
DATA_FILE=./data/products_{{INSTANCE_NAME}}.xlsx
# SQLite база данных (поддерживает {{INSTANCE_NAME}})
DATABASE_PATH=./data/repricer_{{INSTANCE_NAME}}.db

# ============================================
# Веб-интерфейс (Streamlit)
# ============================================

WEB_USER=admin
WEB_PASS=changeme

# ============================================
# Настройки Excel
# ============================================

# Количество интервалов стратегий в Excel (колонки Интервал 1..N, Стратегия 1..N)
SCHEDULE_INTERVALS_COUNT=4
# Префикс колонок URL конкурентов
COMPETITOR_URL_COLUMN_PREFIX=Конкурент
# Префикс колонок цен конкурентов
COMPETITOR_PRICE_COLUMN_PREFIX=Цена

# ============================================
# Настройки ценообразования
# ============================================

# Коэффициент дисконта по умолчанию (fallback если нет индексов)
COEFFICIENT_OZON=0.5
# Множитель для old_price (цена до скидки)
OLD_PRICE_MULTIPLIER=1.5
# Шаг округления old_price (округление вверх до ближайшего)
PRICE_ROUND_UP_TO=100
# Отправлять manage_elastic_boosting_through_price=true в Ozon
MANAGE_ELASTIC_BOOSTING=false
# Пауза после обновления цен перед получением актуальных (секунды)
WAIT_AFTER_UPDATE_SECONDS=10

# ============================================
# Настройки парсера конкурентов
# ============================================

# Макс. количество конкурентов в Excel (колонки Конкурент 1..N, Цена 1..N)
MAX_COMPETITORS=5
# Количество попыток парсинга одной страницы
PARSER_RETRIES=2
# Мин. задержка между запросами парсера (секунды)
PARSER_REQUEST_DELAY_MIN=5
# Макс. задержка между запросами парсера (секунды)
PARSER_REQUEST_DELAY_MAX=10
# Таймаут ожидания освобождения Excel файла (секунды)
EXCEL_LOCK_WAIT_TIMEOUT=60
# Глобальный таймаут блокировки парсера (filelock) (секунды)
PARSER_LOCK_TIMEOUT=1800
# Основная версия Chrome для драйвера (fallback если автоопределение не сработает)
CHROME_VERSION_MAIN=151
# Путь к профилю Chrome (автоопределяется по ОС, можно переопределить)
# Windows: %LOCALAPPDATA%\Google\Chrome\User Data\Default
# Linux: /home/server/chrome_profile
# CHROME_PROFILE_PATH=chrome_profile

# ============================================
# Настройки Ozon API
# ============================================

# Размер батча для API запросов
API_BATCH_SIZE=100
# Макс. количество попыток для неудачных запросов
API_MAX_RETRIES=3
# Задержка между батчами (секунды)
API_BATCH_DELAY=1
# HTTP таймаут запросов (секунды)
API_HTTP_TIMEOUT=30

# ============================================
# Настройки очистки БД
# ============================================

# Срок хранения данных в месяцах
CLEANUP_MONTHS=3
# Мин. дней между автоматическими очистками
CLEANUP_DAYS_THRESHOLD=1
